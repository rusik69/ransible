# {{ ansible_managed }}
host={{ inventory_hostname }}
port={{ app_port }}
env={{ app_env }}
os={{ ansible_facts['os_family'] | default('?') }} {{ ansible_distribution }} {{ ansible_distribution_major_version }}
{% for k, v in features.items() %}
feature_{{ k }}={{ v | ternary('on','off') }}
{% endfor %}
peers={{ groups['app'] | difference([inventory_hostname]) | join(',') }}
